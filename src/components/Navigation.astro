---
/**
 * Fixed top navigation with section links and the light/dark theme toggle.
 * Behaviour (scrolled state, theme persistence) lives in src/scripts/site.js.
 */
export interface NavLink {
  href: string;
  label: string;
}

interface Props {
  brand: string;
  links: NavLink[];
}

const { brand, links } = Astro.props;
---

<nav class="nav" id="nav" aria-label="Main navigation">
  <a href="#" class="nav-logo">{brand}</a>
  <div class="nav-actions">
    <ul class="nav-links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <button class="theme-button" type="button" id="theme-button" aria-label="Switch to light theme" aria-pressed="true" title="Switch to light theme">
      <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.5 6.5 0 0 0 21 12.8Z"/>
      </svg>
      <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
    </button>
  </div>
</nav>
